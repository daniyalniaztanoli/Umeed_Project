# Server
PORT=

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=

# JWT signing secret (use a long random value in production)
JWT_SECRET=

# Optional: comma-separated allowed origins for CORS (leave empty to allow all)
# Example: https://your-admin.example.com,https://your-site.example.com
CORS_ORIGIN=

# Cloudinary (recommended for production - persistent image uploads; without these, uploads use local disk and are lost on Vercel/Render restarts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=umeed
